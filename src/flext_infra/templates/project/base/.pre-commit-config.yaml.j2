        name: make pre-commit
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); {{ make.ci.variable }}={{ make.ci.value }} make pre-commit'
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
{% if make.pre_push %}
{% for step in make.workflow if "pre_push" in step.contexts %}
