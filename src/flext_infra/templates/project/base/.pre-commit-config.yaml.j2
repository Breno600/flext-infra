# Generated by flext_infra codegen for {{ dist }} — DO NOT EDIT
repos:
  - repo: local
    hooks:
    # Why: each make verb is its own pre-commit/pre-push hook so the operator
    # sees per-step status (Passed/Failed) natively via the pre-commit runner.
    # Every step owns its CI context instead of inheriting the caller's token.
    # pre-commit is the fast mutation pass and runs the CI gate set
    # (CI={{ make.ci.value }}). pre-push check unsets {{ make.ci.variable }} to run
    # every active gate; its other verbs retain CI={{ make.ci.local_value }}.
    # Pytest deselects tooling.tools.pytest.ci_excluded_markers
    # only with CI={{ make.ci.value }}, shared by CI and pre-commit. Local and
    # pre-push runs retain those tests; deselection is recorded in test reports.
    # Every hook step owns a shell because Git exports repository-local state,
    # including GIT_INDEX_FILE during pre-commit. A member hook that delegates
    # setup to its repository root must clear those variables first or the root
    # reads the member's temporary index and reports governed gitlinks missing.
    # Inherited Make flags are cleared in the same prefix so each hook step
    # executes its independently declared operation.
    # Stage gates (operator law 2026-08-24): each stage renders only when its
    # config gate (make.pre_commit / make.pre_push) is enabled. Disabled by
    # default; re-enable case by case in config/codegen.yaml.
{% if make.pre_commit %}
{% for step in make.workflow if "pre_commit" in step.contexts %}
      - id: flext-pre-commit-{{ step.verb }}
        name: make {{ step.verb }}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); unset MAKEFLAGS ; {{ make.ci.variable }}={{ make.ci.value }} make {{ step.verb }}'
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
{% endfor %}
{% endif -%}
{% if make.pre_push %}
{% for step in make.workflow if "pre_push" in step.contexts %}
      - id: flext-pre-push-{{ step.verb }}
        name: make {{ step.verb }}
        language: system
        entry: >-
          bash -eu -o pipefail -c 'unset $(git rev-parse --local-env-vars); unset MAKEFLAGS ; {% if step.verb == "check" %}unset {{ make.ci.variable }}; {% else %}{{ make.ci.variable }}={{ make.ci.local_value }} {% endif %}make {{ step.verb }}'
        pass_filenames: false
        always_run: true
        stages: [pre-push]
{% endfor %}
{% endif -%}
