{% from "docker_mise_bootstrap.j2" import docker_header, docker_bootstrap_proof with context -%}
{{ docker_header("arch.Dockerfile.j2", "Arch Linux") }}
FROM archlinux:base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# === SECTION: base packages (pacman) ===
RUN pacman -Syu --noconfirm --needed \
      bash ca-certificates curl git make \
    && pacman -Scc --noconfirm \
    && useradd --create-home --shell /bin/bash runner
# End SECTION: base packages

{{ docker_bootstrap_proof('["make", "help"]') }}
