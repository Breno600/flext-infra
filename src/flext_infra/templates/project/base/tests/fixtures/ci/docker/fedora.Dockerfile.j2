{% from "docker_mise_bootstrap.j2" import docker_header, docker_bootstrap_proof with context -%}
{{ docker_header("fedora.Dockerfile.j2", "Fedora") }}
FROM fedora:41

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# === SECTION: base packages (dnf) ===
RUN dnf install -y \
      bash ca-certificates curl git make libatomic \
    && dnf clean all \
    && useradd --create-home --shell /bin/bash runner
# End SECTION: base packages

{{ docker_bootstrap_proof('["make", "help"]') }}
