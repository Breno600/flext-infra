# NOTE: mise carries itself, the Python runtime and the native tools from the
# config SSOT. The self-managed github:jdx/mise entry is the pinned release:
# `mise install` provisions it from mise.lock and every later `mise` resolved
# through the mise-managed shims runs exactly that release. Python dependency
# declarations remain owned by pyproject.toml. Tools are declared `latest`;
# only `make upg` resolves them and writes the committed mise.lock. Setup
# installs frozen from that lock and never re-resolves.

# === SECTION: settings (managed) ===
# Source: config:codegen.toolchain.mise_lockfile / mise_locked / mise_lockfile_platforms /
#         dependency_cooldown_days (one fleet supply-chain cooldown, operator 2026-10-01)
[settings]
minimum_release_age = "{{ dependency_cooldown_days }}d"
lockfile = {{ "true" if mise_lockfile else "false" }}
locked = {{ "true" if mise_locked else "false" }}
# Third-party releases in the manifest (jscpd, qlty) publish no SLSA
# attestations, so strict lock-time provenance verification can never pass
# for them. API outages degrade to best-effort instead of failing the lock;
# release checksums still enforce integrity, and verification resumes
# automatically wherever attestations exist.
provenance_api_failures_fatal = false
locked_verify_provenance = false
lockfile_platforms = [{% for platform in mise_lockfile_platforms %}"{{ platform }}"{{ ", " if not loop.last }}{% endfor %}]
[settings.python]
compile = {{ "true" if python_compile else "false" }}
[tool_config]
locked = {{ "true" if mise_locked else "false" }}
# End SECTION: settings

# === SECTION: tools (managed) ===
# Source: config:python_version + config:codegen.toolchain mise_selector /
#         mise_version (the self-managed mise entry) + toolchain.tools entries
#         (name, selector, version, version_prefix, form; entry order is the
#         projection order, form fixes the rendered shape)
[tools]
python = "{{ python_version }}"
# mise self-management: the [tools] entry pins the release `mise install`
# provisions from mise.lock; a host bootstrap mise only needs to read that lock.
"{{ mise_selector }}" = "{{ mise_version }}"
# Native toolchain (single source: Infra.codegen.toolchain.tools in codegen.yaml).
{%- for entry in tools %}{% if entry.form == "table" %}
[tools."{{ entry.selector }}"]
version = "{{ tool_versions[entry.name] }}"
{%- if entry.version_prefix %}
version_prefix = "{{ entry.version_prefix }}"
{%- endif %}
{%- elif entry.selector %}
"{{ entry.selector }}" = "{{ tool_versions[entry.name] }}"
{%- else %}
{{ entry.name }} = "{{ tool_versions[entry.name] }}"
{%- endif %}
{%- endfor %}
# End SECTION: tools
