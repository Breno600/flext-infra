{%- if private_dependency_auth %}

      # A private git dependency cannot be cloned with the workflow's own
      # token: secrets.GITHUB_TOKEN is scoped to the repository that runs the
      # workflow, and uv drives dependency clones through plain git, which
      # carries no credential at all. The declared App mints an installation
      # token for the owner, and git reads it from a 0600 file outside the
      # checkout — never from the environment of the build itself.
      - name: Mint the private-dependency installation token
        id: private_dependency_token
        uses: {{ github_actions["create-github-app-token"].repository }}@{{ github_actions["create-github-app-token"].version }}
        with:
          app-id: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.app_id_secret }}{% raw %} }}{% endraw %}
          private-key: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.private_key_secret }}{% raw %} }}{% endraw %}
          owner: {% raw %}${{ github.repository_owner }}{% endraw %}

      - name: Authenticate git for private dependencies
        env:
          PRIVATE_DEPENDENCY_TOKEN: {% raw %}${{ steps.private_dependency_token.outputs.token }}{% endraw %}
        run: |
          set -euo pipefail
          : "${RUNNER_TEMP:?RUNNER_TEMP is required for private dependency identity}"
          if [ -z "${PRIVATE_DEPENDENCY_TOKEN}" ]; then
            echo "::error::the {{ private_dependency_auth.app_id_secret }} App produced no installation token — a private git dependency cannot be resolved"
            exit 1
          fi
          store="$RUNNER_TEMP/flext-private-dependency-credentials"
          install -m 600 /dev/null "$store"
          printf 'https://x-access-token:%s@github.com\n' "$PRIVATE_DEPENDENCY_TOKEN" > "$store"
          git config --global credential.helper "store --file=$store"
{%- endif -%}
