{%- if private_dependency_auth %}

      # A private git dependency cannot be cloned with the workflow's own
      # token: secrets.GITHUB_TOKEN is scoped to the repository that runs the
      # workflow, and uv drives dependency clones through plain git, which
      # carries no credential at all. The declared App mints an installation
      # token for the owner. The 0600 store feeds uv. Setup's submodule
      # command clears credential.helper and sends github.token, so the same
      # url.insteadOf rewrite CI uses keeps this minted token on every
      # https://github.com/ fetch. The token stays out of the build environment.
      - name: Mint the private-dependency installation token
        id: private_dependency_token
        # Push and workflow_dispatch both build the dependency tree; the
        # dispatch form is how the fleet re-runs a consumer's CI after
        # advancing a private member pin (merge-admin 2026-10-07, cosmos-main
        # evidence: the mint skipped on dispatch and the private dep clone
        # failed without credential).
        if: {% raw %}${{ github.event_name == 'push' || github.event_name == 'workflow_dispatch' }}{% endraw %}
        uses: {{ github_actions["create-github-app-token"].repository }}@{{ github_actions["create-github-app-token"].version }}
        with:
          client-id: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.app_id_secret }}{% raw %} }}{% endraw %}
          private-key: {% raw %}${{ secrets.{% endraw %}{{ private_dependency_auth.private_key_secret }}{% raw %} }}{% endraw %}
          owner: {% raw %}${{ github.repository_owner }}{% endraw %}
          repositories: {{ private_dependency_auth.repositories | join(",") }}
          permission-contents: read

      - name: Authenticate git for private dependencies
        if: {% raw %}${{ steps.private_dependency_token.outputs.token != '' }}{% endraw %}
        env:
          PRIVATE_DEPENDENCY_TOKEN: {% raw %}${{ steps.private_dependency_token.outputs.token }}{% endraw %}
        run: |
          set -euo pipefail
          : "${RUNNER_TEMP:?RUNNER_TEMP is required for private dependency identity}"
          if [ -z "${PRIVATE_DEPENDENCY_TOKEN}" ]; then
            echo "::error::the {{ private_dependency_auth.app_id_secret }} App produced no installation token — a private git dependency cannot be resolved"
            exit 1
          fi
          store="$RUNNER_TEMP/flext-private-dependency-credentials"
          install -m 600 /dev/null "$store"
          printf 'https://x-access-token:%s@github.com\n' "$PRIVATE_DEPENDENCY_TOKEN" > "$store"
          printf 'FLEXT_SETUP_CREDENTIAL_STORE=%s\n' "$store" >> "$GITHUB_ENV"
          # The store alone is not enough: it only authenticates when
          # FLEXT_SETUP_CREDENTIAL_STORE survives every make and mise hop into
          # the uv sync receipt. The cosmos-main CI evidence (runs
          # 37536376992 and 37614946505, 2026-10) shows uv's git fetch still
          # ran with no credential ("could not read Username") even though
          # this step minted and stored the token. Install the url.insteadOf
          # rewrite this fragment's header already documents: a global git
          # config file is read from disk by every https://github.com/ fetch
          # (uv's git subprocesses, submodules, bare git), so the minted
          # token rides them regardless of environment propagation. Same
          # mechanism as the cross-repo dependency credential fragment.
          git config --global url."https://x-access-token:${PRIVATE_DEPENDENCY_TOKEN}@github.com/".insteadOf "https://github.com/"
{%- endif -%}
