{#- Adaptive testmon cache (flext-dipb). Save gated by make.testmon_cache.save_enabled. -#}
{%- set tc = make.testmon_cache %}
      - name: Restore testmon cache
        id: testmon-restore
        uses: {{ github_actions["cache"].repository }}@{{ github_actions["cache"].version }}
        with:
          path: |
            {% raw %}${{ github.workspace }}{% endraw %}/{{ tc.database_filename }}
          key: {{ tc.key_prefix }}-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-py{{ python_version }}-{% raw %}${{ hashFiles('pyproject.toml', '**/pyproject.toml') }}-${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
          restore-keys: |
            {{ tc.key_prefix }}-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-py{{ python_version }}-{% raw %}${{ hashFiles('pyproject.toml', '**/pyproject.toml') }}-{% endraw %}
            {{ tc.key_prefix }}-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-py{{ python_version }}-
{%- if tc.save_enabled %}

      - name: Save testmon cache
        if: {% raw %}${{ success() && !cancelled() && github.ref == 'refs/heads/0.12.0-dev' && github.event_name == 'push' }}{% endraw %}
        uses: {{ github_actions["cache"].repository }}@{{ github_actions["cache"].version }}
        with:
          path: |
            {% raw %}${{ github.workspace }}{% endraw %}/{{ tc.database_filename }}
          key: {{ tc.key_prefix }}-{% raw %}${{ runner.os }}-${{ runner.arch }}{% endraw %}-py{{ python_version }}-{% raw %}${{ hashFiles('pyproject.toml', '**/pyproject.toml') }}-${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
{%- endif %}
