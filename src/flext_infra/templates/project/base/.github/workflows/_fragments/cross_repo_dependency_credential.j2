
      # Cross-repo private git dependencies: the workflow token is scoped to
      # this repository only, so it cannot clone siblings that turn private.
      # Every declared sibling is public today and resolves anonymously; the
      # credential exists for the private-sibling scenario. When the org
      # installs its cross-repo dependency GitHub App and exposes
      # CI_DEPENDENCIES_APP_ID / CI_DEPENDENCIES_APP_PRIVATE_KEY, mint a
      # short-lived installation token and scope it to github.com clones.
      # Absent secrets make this step a recorded NOT EXECUTED while the
      # repository has not declared the credential requirement; a repository
      # that declares the CI_DEPENDENCIES_REQUIRED repo variable fails the
      # job non-zero with a typed message and without exposing any secret
      # value (cosmos-1yzig: absence normalized as success is a defect).
      - name: Mint cross-repo dependency credential
        env:
          CI_DEPS_APP_ID: {% raw %}${{ secrets.CI_DEPENDENCIES_APP_ID }}{% endraw %}
          CI_DEPS_APP_KEY: {% raw %}${{ secrets.CI_DEPENDENCIES_APP_PRIVATE_KEY }}{% endraw %}
          CI_DEPS_REQUIRED: '0'
        run: |
          set -euo pipefail
          if [ -z "$CI_DEPS_APP_ID" ] || [ -z "$CI_DEPS_APP_KEY" ]; then
            case "$CI_DEPS_REQUIRED" in
              1 | true | TRUE | True | yes | YES | Yes)
                echo "ERROR[CI_CREDENTIAL_REQUIRED]: CI_DEPENDENCIES_APP_ID/CI_DEPENDENCIES_APP_PRIVATE_KEY are declared required by this repository and are absent or empty" >&2
                exit 1
                ;;
              *)
                echo "NOT EXECUTED: CI_DEPENDENCIES_* secrets absent, no cross-repo credential minted"
                exit 0
                ;;
            esac
          fi
          identity_root="$RUNNER_TEMP/flext-cross-repo-deps"
          install -d -m 700 "$identity_root"
          key_path="$identity_root/app-key.pem"
          printf '%s\n' "$CI_DEPS_APP_KEY" > "$key_path.new"
          chmod 600 "$key_path.new"
          mv "$key_path.new" "$key_path"
          b64url() {
            openssl base64 -A | tr '+/' '-_' | tr -d '='
          }
          now=$(date +%s)
          header='{"alg":"RS256","typ":"JWT"}'
          payload=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$CI_DEPS_APP_ID")
          input="$(printf %s "$header" | b64url).$(printf %s "$payload" | b64url)"
          signature=$(printf %s "$input" | openssl dgst -sha256 -sign "$key_path" | b64url)
          jwt="$input.$signature"
          # Credential mint without curl-pipe-to-shell (semgrep gha-curl-pipe-shell):
          # responses land in a temp file and are parsed from disk, never piped.
          response_file="$identity_root/github-api-response.json"
          curl -sfS -X GET -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" -o "$response_file" https://api.github.com/app/installations
          installation_id=$(python3 -c 'import json, sys; entries = json.load(open(sys.argv[1])); assert len(entries) == 1, f"expected exactly one app installation, got {len(entries)}"; print(entries[0]["id"])' "$response_file")
          curl -sfS -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" -o "$response_file" "https://api.github.com/app/installations/$installation_id/access_tokens"
          access_token=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["token"])' "$response_file")
          rm -f "$response_file"
          echo "::add-mask::$access_token"
          git config --global url."https://x-access-token:${access_token}@github.com/".insteadOf "https://github.com/"
          rm -f "$key_path"
