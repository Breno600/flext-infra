      # Why (flext-gd3m1): a cold runner re-downloaded every locked Mise tool
      # (go included) on every run, and a network blip failed setup. The cache
      # is content-addressed by the committed locks, so a warm cache is always
      # valid for the same lock and can never hide a finding; it only removes
      # the cold download of the pinned tarballs.
      - name: Restore tool caches
        id: tool-cache
        uses: {{ github_actions["cache"].repository }}/restore@{{ github_actions["cache"].version }}
        with:
          path: |
            {{ make.clean.cache_dirs | join("\n            ") }}
            ~/.cache/uv
            ~/.cache/pyright
            ~/.local/share/mise
          key: {% raw %}${{ runner.os }}-{% endraw %}{{ python_version }}{% raw %}-tools-${{ hashFiles('uv.lock', 'mise.lock', 'pyproject.toml') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-{% endraw %}{{ python_version }}{% raw %}-tools-{% endraw %}
