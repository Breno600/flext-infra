
{%- if make.testmon_cache_policy.save_enabled %}
      # Completed failing tests may save; cancelled/incomplete/corrupt runs cannot.
      - name: Save testmon database
        if: >-
          {% raw %}${{ always() && !cancelled() && github.event_name == 'push' && steps.approval.outputs.testmon_saveable == 'true' && steps.approval.outputs.testmon_database == steps.testmon_path.outputs.database && steps.approval.outputs.testmon_digest != '' && contains(fromJSON('{% endraw %}{{ make.testmon_cache_policy.allowed_save_refs | list | tojson }}{% raw %}'), github.ref_name) && startsWith(github.ref, 'refs/heads/') }}{% endraw %}
        uses: {{ github_actions["cache"].repository }}/save@{{ github_actions["cache"].version }}
        with:
          path: {% raw %}${{ steps.approval.outputs.testmon_database }}{% endraw %}
          key: {% raw %}${{ runner.os }}-{% endraw %}{{ python_version }}-{{ make.testmon_cache_policy.key_prefix }}-{{ dist }}-{% raw %}${{ hashFiles('uv.lock', 'mise.lock', 'pyproject.toml', 'config/**') }}-${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
{%- endif %}
