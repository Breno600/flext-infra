{#- Native mise installation for one CI job. The step provides the host
    binary and its shims on PATH AND immediately provisions the release the
    committed mise.lock pins (SSOT — no second hardcoded version), so a guard
    or setup step resolving mise on this runner always sees the declared
    release, never a late or missing one (root cures #461/#462, landed at the
    fragment so every workflow site inherits them). Install the configured
    request, not an explicit version override with a different lock identity.
    Publish the verified binary directory without changing global config.
    bash is pinned explicitly so the same fragment runs on Windows runners. #}
      - name: Install the mise release pinned by mise.lock
        shell: bash
        run: |
          set -eu
          curl -fsSL https://mise.run | sh
          echo "${HOME}/.local/bin" >> "${GITHUB_PATH}"
          echo "${HOME}/.local/share/mise/shims" >> "${GITHUB_PATH}"
          mise_pin="$(awk 'index($0, "[[tools.\"github:jdx/mise\"]]") == 1 { inside = 1; next } inside && substr($0, 1, 1) == "[" { exit } inside && $1 == "version" { gsub(/[",]/, "", $3); print $3; exit }' mise.lock)"
          if [ -z "${mise_pin}" ]; then
            printf 'ERROR: mise.lock pins no github:jdx/mise release; run make upg\n' >&2
            exit 2
          fi
          "${HOME}/.local/bin/mise" install --locked github:jdx/mise
          mise_path="$("${HOME}/.local/bin/mise" which mise)"
          mise_receipt="$("${mise_path}" --version | cut -d ' ' -f1)"
          if [ "${mise_receipt}" != "${mise_pin}" ]; then
            printf 'ERROR: provisioned Mise %s differs from mise.lock pin %s; run make setup\n' "${mise_receipt}" "${mise_pin}" >&2
            exit 2
          fi
          echo "${mise_path%/*}" >> "${GITHUB_PATH}"
