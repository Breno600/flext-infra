
      # Why: Mypy's project-keyed analysis cache (make.mypy_cache) lives outside
      # the checkout. A runner without it re-analyses the whole dependency
      # closure, and a bounded run can die before it writes anything. Restore
      # the newest cache of any earlier run: Mypy revalidates every entry by
      # source hash, so a warm cache removes recompute and never hides a finding.
      - name: Restore Mypy cache
        uses: {{ github_actions["cache"].repository }}/restore@{{ github_actions["cache"].version }}
        with:
          path: ~/{{ make.mypy_cache.home_cache_directory }}/{{ make.mypy_cache.external_storage_directory }}
          key: {% raw %}${{ runner.os }}-{% endraw %}{{ python_version }}{% raw %}-mypy-${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-{% endraw %}{{ python_version }}{% raw %}-mypy-{% endraw %}
