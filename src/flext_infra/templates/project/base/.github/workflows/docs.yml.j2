# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
name: Docs

"on":
  push:
    branches:
{%- for branch in ci_trigger_branches %}
      - {{ branch }}
{%- endfor %}
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "pyproject.toml"
{% for repository in workspace_repositories %}
      - "{{ repository.path }}/**"
{% endfor %}
      - ".github/workflows/docs.yml"
  workflow_dispatch:

permissions: {}

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  docs-quality:
    name: docs-quality
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    # Why: GitHub-hosted runners share egress IPs, so the unauthenticated
    # 60 req/h REST budget is exhausted before mise resolves the moving
    # @latest backends (observed 2026-09-23: 403, rate limit 0/60, on every
    # backend in Sync workspace toolchain), and docs generation reads the
    # governed sibling repos. The job token authenticates both, as in CI.
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}

      # Why: a cold runner re-downloaded every locked Mise tool
      # (go included) on every Docs run, and a network blip failed setup. The
      # cache is content-addressed by the committed locks, so a warm cache is
      # always valid for the same lock and can never hide a finding; it only
      # removes the cold download of the pinned tarballs.
{%- include "_fragments/toolchain_cache_restore.j2" %}

      - name: Sync workspace toolchain
        run: make setup

      # Why: save on every outcome — including a failing gate — so the next run
      # starts warm. Only written when the restore missed.
{%- include "_fragments/toolchain_cache_save.j2" %}

      - name: Generation drift (blocking)
        run: |
          make gen
          make verify-clean

      - name: Docs lifecycle (blocking)
        run: make docs

      # The preceding generation check cannot see changes made by make docs.
      - name: Verify docs byte-identical repository
        run: make verify-clean

      # Failure diagnostics execute only after the original Make step has
      # already propagated its exact status to Actions.
      - name: Dump docs reports on failure
        if: failure()
        run: |
          set -eu
          for report_root in .reports apps; do
            if [ -d "$report_root" ]; then
              find "$report_root" \
                \( {% for name in docs_report_filenames %}{% if not loop.first %}-o {% endif %}-path '*/{{ name }}' {% endfor %}\) \
                -type f -exec sh -eu -c '
                  for report_file do
                    printf "::group::%s\n" "$report_file"
                    tail -n 80 "$report_file"
                    printf "::endgroup::\n"
                  done
                ' sh {} +
            fi
          done

      - name: Upload docs reports on failure
        if: failure()
        uses: {{ github_actions["upload-artifact"].repository }}@{{ github_actions["upload-artifact"].version }}
        with:
          name: docs-reports
          # Structured docs reports only — omit raw docs log trees that may carry
          # env-derived secrets from setup/docs phases.
          path: |{% for prefix in (".reports/**", "apps/*/.reports/**") %}{% for name in docs_report_filenames %}
            {{ prefix }}/{{ name }}{% endfor %}{% endfor %}
          if-no-files-found: error
          # The allowlisted reports live under hidden .reports directories.
          # upload-artifact excludes hidden paths unless this is explicit.
          include-hidden-files: true
          retention-days: 7

  build:
    name: build
    needs: docs-quality
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: read
    # Why: same authenticated toolchain and docs-source resolution as docs-quality.
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
    steps:
      - name: Checkout
        uses: {{ github_actions["checkout"].repository }}@{{ github_actions["checkout"].version }}
        with:
          submodules: {{ checkout_submodules }}
          fetch-depth: 0
{%- include "_fragments/private_submodules_init.j2" %}
{%- include "_fragments/private_dependency_auth.j2" %}

      # Why: same cold-download protection as the docs-quality job.
{%- include "_fragments/toolchain_cache_restore.j2" %}

      - name: Sync workspace toolchain
        run: make setup

{%- include "_fragments/toolchain_cache_save.j2" %}

      - name: Build site
        run: make docs

      - name: Verify byte-identical repository
        run: make verify-clean

      # Pages configure/upload exist only to feed deploy on main. Running them on
      # every integration push fails closed when Pages is unset and is wasted
      # work when deploy is skipped (deploy already gates on refs/heads/main).
      - name: Configure Pages
        if: github.ref == 'refs/heads/main'
        uses: {{ github_actions["configure-pages"].repository }}@{{ github_actions["configure-pages"].version }}

      - name: Upload site artifact
        if: github.ref == 'refs/heads/main'
        uses: {{ github_actions["upload-pages-artifact"].repository }}@{{ github_actions["upload-pages-artifact"].version }}
        with:
          path: .reports/docs/site

  deploy:
    name: deploy
    needs: build
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: {{ github_actions["deploy-pages"].repository }}@{{ github_actions["deploy-pages"].version }}
