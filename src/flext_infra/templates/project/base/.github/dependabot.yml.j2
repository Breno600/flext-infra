# Generated by `flext-infra codegen conform` for {{ dist }} — DO NOT EDIT.
{# One fleet cooldown (codegen.toolchain.dependency_cooldown_days); pip entries
   exclude the forks and local projects the project takes by git reference. -#}
{% set cooldown = "\n    cooldown:\n      default-days: " ~ dependency_cooldown_days -%}
{% set pip_cooldown = cooldown ~ ("\n      exclude: [" ~ (cooldown_excluded_dependencies | map("tojson") | join(", ")) ~ "]" if cooldown_excluded_dependencies else "") -%}
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, github-actions]{{ cooldown }}
{% if has_devcontainer %}
  - package-ecosystem: devcontainers
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, devcontainers]{{ cooldown }}

{% endif %}
  - package-ecosystem: pip
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, python]{{ pip_cooldown }}
{% for repository in workspace_repositories if repository.package and repository.path != "." %}

  - package-ecosystem: pip
    directory: /{{ repository.path }}
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, python]{{ pip_cooldown }}
{% endfor -%}
