{% endfor %}
]
precision = {{ tooling.tools.coverage.precision }}
show_missing = {{ tooling.tools.coverage.show_missing | lower }}
skip_covered = {{ tooling.tools.coverage.skip_covered | lower }}

[tool.coverage.run]
source = [
{% for item in tooling.tools.coverage.source %}
  {{ item | tojson }},
{% endfor %}
]
omit = [
{% for item in tooling.tools.coverage.omit %}
  {{ item | tojson }},
{% endfor %}
]

[tool.deptry]
known_first_party = [
{% for item in tooling_runtime.first_party %}
  {{ item | tojson }},
{% endfor %}
]
pep621_dev_dependency_groups = [
{% for item in tooling.tools.deptry.pep621_dev_dependency_groups %}
  {{ item | tojson }},
{% endfor %}
]

[tool.flext.docs]
package_name = {{ package_name | tojson }}

[tool.hatch.metadata]
allow-direct-references = {{ tooling.tools.hatch.allow_direct_references | lower }}
{% if make_profile != "workspace" %}
{% if hatch_build_hook_path %}

{# NOTE: emit only the project-owned declaration. #}
[tool.hatch.build.hooks.custom]
path = {{ hatch_build_hook_path | tojson }}
{% endif %}

[tool.hatch.build.targets.wheel]
{% if packaged_data_excludes %}
exclude = [
{% for data_path in packaged_data_excludes %}
  {{ ("/" ~ data_path) | tojson }},
{% endfor %}
]
{% endif %}
include = [
  "/src/{{ package_name }}/**",
{% for package in root_packages %}
  {{ ("/src/" ~ package ~ "/**") | tojson }},
{% endfor %}
{% for data_path in packaged_data_paths if data_path not in packaged_data_files %}
  {{ ("/" ~ data_path ~ "/**") | tojson }},
{% endfor %}
{% for namespace in repository_namespace_packages %}
  {{ ("/" ~ namespace ~ "/**") | tojson }},
{% endfor %}
]

[tool.hatch.build.targets.wheel.sources]
{{ ("src/" ~ package_name) | tojson }} = {{ package_name | tojson }}
{% for package in root_packages %}
{{ ("src/" ~ package) | tojson }} = {{ package | tojson }}
{% endfor %}
{% for data_path in packaged_data_paths if data_path not in packaged_data_files %}
{{ data_path | tojson }} = {{ (package_name ~ "/" ~ data_path) | tojson }}
{% endfor %}
{% for namespace in repository_namespace_packages %}
{{ namespace | tojson }} = {{ namespace | tojson }}
{% endfor %}
{% if packaged_data_files or root_modules %}

[tool.hatch.build.targets.wheel.force-include]
{% for data_dir in packaged_data_files %}
{{ data_dir | tojson }} = {{ (package_name ~ "/" ~ data_dir) | tojson }}
{% endfor %}
{% for module in root_modules %}
{{ ("src/" ~ module ~ ".py") | tojson }} = {{ (module ~ ".py") | tojson }}
{% endfor %}
{% endif %}

[tool.hatch.build.targets.sdist]
{% if packaged_data_excludes %}
exclude = [
{% for data_path in packaged_data_excludes %}
  {{ ("/" ~ data_path) | tojson }},
{% endfor %}
]
{% endif %}
include = [
  "/src/{{ package_name }}/**",
{% for package in root_packages %}
  {{ ("/src/" ~ package ~ "/**") | tojson }},
{% endfor %}
{% for data_dir in packaged_data_paths if data_dir not in packaged_data_files %}
  {{ ("/" ~ data_dir ~ "/**") | tojson }},
{% endfor %}
{% for namespace in repository_namespace_packages %}
  {{ ("/" ~ namespace ~ "/**") | tojson }},
{% endfor %}
]
{% if packaged_data_files or root_modules or hatch_build_hook_path %}

[tool.hatch.build.targets.sdist.force-include]
{% for data_file in packaged_data_files %}
{{ data_file | tojson }} = {{ data_file | tojson }}
{% endfor %}
{% for module in root_modules %}
{{ ("src/" ~ module ~ ".py") | tojson }} = {{ ("src/" ~ module ~ ".py") | tojson }}
{% endfor %}
{% if hatch_build_hook_path %}
{# uv 0.12 builds the wheel FROM the sdist: the declared custom hook must ride in it. Force-include keeps the wheel/sdist source patterns equal (release metadata contract). #}
{{ hatch_build_hook_path | tojson }} = {{ hatch_build_hook_path | tojson }}
{% endif %}
{% endif %}
{% endif %}

