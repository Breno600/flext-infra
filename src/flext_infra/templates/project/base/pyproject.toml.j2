{#- The generated-file header is not rendered here: the pyproject projection
is a parse-merge-dump of this render and the live CUSTOM surface, which drops
every comment. Its composition owner (compose_project_artifact) prepends the
single header constant c.Infra.BANNER to the final projection. -#}
{#- A bare internal flext-* entry is only a floor name: it declares no Git
source, and conform fails loudly on source-less internal dependencies. The
scaffold seeds the source from the declared FLEXT dependency line; the
dependency lists are CUSTOM afterwards, so the declaration then rules. -#}
{%- macro flext_requirement(item) -%}
{%- set bare = item is string and item.startswith("flext-") and item.replace("-", "").replace("_", "").isalnum() -%}
{%- if bare -%}
"{{ item }} @ git+{{ flext_git_base_url }}/{{ item }}.git@{{ flext_git_branch }}"
{%- else -%}
{{ item | tojson }}
{%- endif -%}
{%- endmacro -%}

# [MANAGED] build-system
[build-system]
build-backend = {{ scaffold.build.backend | tojson }}
requires = [
{% for item in scaffold.build.requirements %}
  {{ item | tojson }},
{% endfor %}
]

# [CUSTOM] name, description, authors, maintainers, scripts, entry-points, classifiers, keywords, license, urls, readme, version, dependencies, optional-dependencies
# [MANAGED] requires-python
# Runtime profile requirements take precedence over same-name CUSTOM dependencies.
[project]
classifiers = [
{% for item in scaffold.project.classifiers %}
  {{ item | tojson }},
{% endfor %}
]
dependencies = [
{% for item in runtime_dependency_overlay %}
  {{ flext_requirement(item) }},
{% endfor %}
{% for item in dependency_profile.runtime if item != dist %}
  {{ flext_requirement(item) }},
{% endfor %}
]
description = "{{ description }}"
keywords = [
{% for item in scaffold.project.keywords %}
  {{ item | tojson }},
{% endfor %}
]
license = "{{ license }}"
name = "{{ dist }}"
readme = {{ scaffold.project.readme | tojson }}
requires-python = "{{ python_required_version }}"
version = "{{ version }}"

[[project.authors]]
email = "{{ author_email }}"
name = "{{ author_name }}"

[[project.maintainers]]
email = "{{ author_email }}"
name = "{{ author_name }}"

[dependency-groups]
codegen = [
{% for item in dependency_profile.codegen if item != dist %}
  {{ flext_requirement(item) }},
{% endfor %}
]
dev = [
{% for item in scaffold.project.dev if item != dist %}
  {{ flext_requirement(item) }},
{% endfor %}
]
{% if cli_module %}
[project.scripts]
{{ dist }} = "{{ package_name }}.cli:main"
{% endif %}
{% if repository %}

[project.urls]
Documentation = "{{ documentation }}"
Homepage = "{{ homepage }}"
Repository = "{{ repository }}"
{% endif %}

[tool.codespell]
check-filenames = {{ tooling.tools.codespell.check_filenames | lower }}
ignore-words-list = {{ tooling.tools.codespell.ignore_words_list | tojson }}

[tool.coverage.report]
