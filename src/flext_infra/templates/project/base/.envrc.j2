# === SECTION: strict evaluation and watched inputs (managed) ===
# Source: template (direnv stdlib contract)
strict_env
watch_file .mise.toml
watch_file pyproject.toml
# End SECTION: strict evaluation and watched inputs

# === SECTION: repository environment (managed) ===
# Source: computed:nearest-pyproject-via-direnv-find_up + template
PROJECT_ROOT="$(find_up pyproject.toml)"
PROJECT_ROOT="${PROJECT_ROOT%/*}"
PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd -P)"
RUNTIME_ROOT="$(git -C "${PROJECT_ROOT}" rev-parse --show-superproject-working-tree)"
if [[ -n "${RUNTIME_ROOT}" ]]; then
  RUNTIME_ROOT="$(cd "${RUNTIME_ROOT}" && pwd -P)"
else
  RUNTIME_ROOT="${PROJECT_ROOT}"
fi
VENV_DIR="${RUNTIME_ROOT}/.venv"
PROJECT_STATE_ROOT="${PROJECT_ROOT%/*}/{{ state_directory_name }}/${PROJECT_ROOT##*/}"
# Scratch never lives inside a versioned tree: the home scratch root mirrors
# the absolute checkout path so a sandbox is never a tracked scope of any
# enclosing repository (workspace or linked worktree). Checkouts nested in a
# VCS directory rename that segment, so the mirror never contains one.
PROJECT_SCRATCH_IDENTITY="${PROJECT_ROOT}/"
{% for segment, alias in scratch_identity_segment_aliases -%}
scratch_segment="/{{ segment }}/"
scratch_alias="/{{ alias }}/"
while [[ "${PROJECT_SCRATCH_IDENTITY}" == *"${scratch_segment}"* ]]; do
  PROJECT_SCRATCH_IDENTITY="${PROJECT_SCRATCH_IDENTITY//"${scratch_segment}"/"${scratch_alias}"}"
done
{% endfor -%}
PROJECT_SCRATCH_IDENTITY="${PROJECT_SCRATCH_IDENTITY%/}"
PROJECT_SCRATCH="${HOME}/{{ scratch_home_relative }}/{{ state_directory_name }}${PROJECT_SCRATCH_IDENTITY}/{{ scratch_namespace }}"
mkdir -p "${PROJECT_SCRATCH}"
if command -v chattr >/dev/null 2>&1; then
  project_scratch_fs="$(stat -f -c %T "${PROJECT_SCRATCH}")"
  if [[ "${project_scratch_fs}" == "btrfs" ]]; then
    chattr +C "${PROJECT_SCRATCH}"
  fi
fi
export PROJECT_ROOT
export TMPDIR="${PROJECT_SCRATCH}"
export GOTMPDIR="${PROJECT_SCRATCH}"
export PYTHON_KEYRING_BACKEND="keyring.backends.null.Keyring"
# Bytecode caching is required. The external cache prefix preserves compiled
# modules between commands while Git remains the sole owner of file visibility.
export PYTHONPYCACHEPREFIX="${PROJECT_STATE_ROOT}/{{ pycache_namespace }}"
export PYTHONUNBUFFERED=1
# End SECTION: repository environment

# === SECTION: mise activation (managed) ===
# Source: typed generated Mise storage contract; setup owns installation.
if [[ -v {{ mise_bootstrap.storage_root_variable }} ]] && [[ -n "${{ '{' }}{{ mise_bootstrap.storage_root_variable }}{{ '}' }}" ]]; then
  MISE_STORAGE_ROOT="${{ '{' }}{{ mise_bootstrap.storage_root_variable }}{{ '}' }}"
elif [[ -v XDG_DATA_HOME ]] && [[ -n "${XDG_DATA_HOME}" ]]; then
  MISE_STORAGE_ROOT="${XDG_DATA_HOME}/mise"
elif [[ -v HOME ]] && [[ -n "${HOME}" ]]; then
  MISE_STORAGE_ROOT="${HOME}/.local/share/mise"
else
  log_error "{{ mise_bootstrap.storage_root_variable }}, XDG_DATA_HOME, or HOME must identify persistent Mise storage"
  return 1
fi
case "${MISE_STORAGE_ROOT}" in
  /*) ;;
  *) log_error "{{ mise_bootstrap.storage_root_variable }} must be absolute"; return 1 ;;
esac
export {{ mise_bootstrap.storage_root_variable }}="${MISE_STORAGE_ROOT}"
{% for name, relative in mise_bootstrap.persistent_environment if name == "MISE_SHIMS_DIR" -%}
export {{ name }}="${MISE_STORAGE_ROOT}{% if relative != "." %}/{{ relative }}{% endif %}"
PATH_add "${{ '{' }}{{ name }}{{ '}' }}"
{% endfor -%}
# End SECTION: mise activation

# === SECTION: configured paths (managed) ===
# Source: config:environment_path_prepends
# The tracked bin/mise launcher is reached by the Makefile through its own
# path, never through PATH: a project bin on PATH made `mise reshim` inside a
# direnv-loaded checkout bind every shim of the shared MISE_DATA_DIR to that
# checkout's launcher.
{%- for extra_path in environment_path_prepends %}
if [[ -d "${PROJECT_ROOT}/{{ extra_path }}" ]]; then
  PATH_add "${PROJECT_ROOT}/{{ extra_path }}"
fi
{% endfor %}
# End SECTION: configured paths

# === SECTION: virtual environment (managed) ===
# Source: physical Git superproject owns .venv; unattached checkouts own theirs.
if [[ -f "${PROJECT_ROOT}/pyproject.toml" && -d "${VENV_DIR}" ]]; then
  export UV_PROJECT_ENVIRONMENT="${VENV_DIR}"
  export VIRTUAL_ENV="${VENV_DIR}"
  PATH_add "${VENV_DIR}/bin"
else
  unset UV_PROJECT_ENVIRONMENT
  unset VIRTUAL_ENV
fi
# End SECTION: virtual environment

{% if gascity is not none %}
{%- if gascity.backend == "gascity" %}
# Repository policy permits this capability; the caller's explicit city
# identity selects its runtime. Standalone activation owns no inherited ledger.
if [[ -v {{ gascity.identity_var }} ]]; then
{% include "_envrc_beads.j2" %}
else
{% for var in gascity.unset_vars -%}
  unset {{ var }}
{% endfor -%}
  unset BEADS_DOLT_SERVER_HOST BEADS_DOLT_SERVER_PORT
  unset BEADS_DOLT_SERVER_DATABASE BEADS_DOLT_SERVER_MODE
  unset BEADS_DOLT_AUTO_START
fi
{%- elif gascity.backend == "local" %}
# Repository-owned Beads base: bd owns the local Dolt server lifecycle
# through .beads/config.yaml; inherited orchestration endpoints never apply.
checkout_root="$(pwd -P)"
watch_file "${checkout_root}/{{ gascity.beads_metadata_relpath }}"
{% for var in gascity.unset_vars -%}
unset {{ var }}
{% endfor -%}
unset BEADS_DOLT_SERVER_HOST BEADS_DOLT_SERVER_PORT
unset BEADS_DOLT_SERVER_DATABASE BEADS_DOLT_SERVER_MODE
unset BEADS_DOLT_AUTO_START
{%- else %}
# No Beads identity in this repository: inherited orchestration and Beads
# endpoint variables never leak into the activation.
{% for var in gascity.unset_vars -%}
unset {{ var }}
{% endfor -%}
unset BEADS_DOLT_SERVER_HOST BEADS_DOLT_SERVER_PORT
unset BEADS_DOLT_SERVER_DATABASE BEADS_DOLT_SERVER_MODE
unset BEADS_DOLT_AUTO_START
{%- endif %}
{%- endif %}

# === SECTION: local overrides (managed) ===
# Source: template. Repository-local, tracked overrides load last and win;
