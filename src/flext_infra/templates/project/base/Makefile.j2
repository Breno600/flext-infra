endif
override SELF_MAKE := "$(SELF_MAKE_EXECUTABLE)" --no-print-directory -f "$(SELF_MAKEFILE)"

define RUN_PUBLIC_POST
	$(if $(filter post-$(1),$(CUSTOM_DECLARED_TARGETS)),+@$(SELF_MAKE) post-$(1))
endef

# A public verb is its producer half (pre hook plus handler) followed by its
# activation half. An activation producer re-enters the environment its
# producer just rendered; `upg` runs the two halves apart so the toolchain
# lock is resolved from that rendered manifest before activation demands it.
define RUN_PUBLIC_PRODUCE
	$(if $(filter pre-$(1),$(CUSTOM_DECLARED_TARGETS)),+@$(SELF_MAKE) pre-$(1))
	$(if $(filter _custom-$(1),$(CUSTOM_DECLARED_TARGETS)),+@$(SELF_MAKE) _custom-$(1),+@$(SELF_MAKE) _builtin-$(1))
endef

define RUN_PUBLIC_ACTIVATE
	+@direnv exec "$(PROJECT_ROOT)" $(SELF_MAKE) _activated-$(1)
endef

define RUN_PUBLIC
$(call RUN_PUBLIC_PRODUCE,$(1))
	$(if $(2),$(call RUN_PUBLIC_ACTIVATE,$(1)),$(call RUN_PUBLIC_POST,$(1)))
endef

{% if script_dispatch %}
# Script-dispatch routing: a declared ``_custom_<verb>_<what>`` handler wins
# before the allowlist; otherwise the dispatcher resolves <verb>/<WHAT> across
# SCRIPT_ROOTS. Bare verbs reach the dispatcher, which renders verb help.
define _dispatch
	@set -eu; \
	what="$(WHAT)"; \
	custom="_custom_$(1)_$$what"; \
	if [ -n "$$what" ] && $(SELF_MAKE) -n "$$custom" >/dev/null 2>&1; then \
		$(SELF_MAKE) "$$custom"; \
	elif [ -n "$$what" ]; then \
		what_norm="$$(printf '%s' "$$what" | tr '-' '_')"; \
		found=""; \
		for root in $(SCRIPT_ROOTS); do \
			if [ -f "$(PROJECT_ROOT)/$$root/$(1)/$${what_norm}.py" ] || [ -f "$(PROJECT_ROOT)/$$root/$(1)/$${what_norm}.sh" ] || [ -f "$(PROJECT_ROOT)/$$root/$(1)/all.sh" ]; then \
				found="$$root/$(1)"; \
			fi; \
		done; \
		if [ -n "$$found" ]; then \
			WHAT="$$what" $(UV_RUN) python "$(PROJECT_ROOT)/{{ script_dispatch.dispatcher }}" "$(1)"; \
		else \
			printf 'ERROR: no script handler for %s WHAT=%s (roots: %s)\n' "$(1)" "$$what" "$(SCRIPT_ROOTS)" >&2; \
			exit 2; \
		fi; \
	else \
		WHAT="" $(UV_RUN) python "$(PROJECT_ROOT)/{{ script_dispatch.dispatcher }}" "$(1)"; \
	fi
endef
{% endif %}

# `make upg` is the only verb that writes uv.lock (`uv lock --upgrade
