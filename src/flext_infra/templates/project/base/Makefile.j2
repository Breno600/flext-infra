ifneq ($(.SHELLSTATUS),0)
$(error Cannot resolve Git common directory for $(RUNTIME_ROOT))
endif
ifneq ($(RUNTIME_GIT_DIR),$(RUNTIME_GIT_COMMON_DIR))
RUNTIME_LINKED_WORKTREE := Y
endif
endif
ifeq ($(RUNTIME_LINKED_WORKTREE),Y)
