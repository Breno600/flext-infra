{# Shared mkdocs.yml macros — single source of truth for theme, plugins, validation. #}
{# Imported by mkdocs_project.yml.j2 and mkdocs_root.yml.j2 — DO NOT INLINE THESE. #}
{# All loop/conditional logic is pre-formatted in Python and passed as ready strings. #}
{%- macro site_components(exclude_docs_block, exclude_plugin_block, mkdocstrings_paths_block) -%}
docs_dir: docs
site_dir: .reports/docs/site

{{ exclude_docs_block }}{{ material_theme() }}

{{ plugins_block(exclude_plugin_block, mkdocstrings_paths_block) }}

{{ markdown_extensions_block() }}
{%- endmacro %}
{%- macro material_theme() -%}
theme:
  name: material
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - toc.integrate
    - content.code.copy
    - content.tabs.link
    - search.highlight
    - search.share
    - search.suggest
  palette:
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/weather-night
        name: Switch to dark mode
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/weather-sunny
        name: Switch to light mode
{%- endmacro %}
{%- macro plugins_block(exclude_plugin_block, mkdocstrings_paths_block) -%}
{# Plugin distributions are declared by config/codegen.yaml scaffold.project.dev. #}
plugins:
  - search
{{ exclude_plugin_block }}  - autorefs
  - section-index
  - mkdocstrings:
      handlers:
        python:
{{ mkdocstrings_paths_block }}          docstring_style: auto
          options:
            show_root_heading: true
            show_root_full_path: false
            show_source: false
            show_signature_annotations: true
            separate_signature: true
            merge_init_into_class: true
            docstring_section_style: spacy
  - git-revision-date-localized:
      # Why: enable_creation_date resolves via 'git log --diff-filter=Ar', which returns
      # EMPTY for pages whose only add-commit is a merge commit. The plugin then falls back
      # to time.time() (build clock), making first_revision > last_revision always true,
      # which logs a warning that mkdocs --strict turns into a build failure. Revision date
      # from the last commit touching the page is the intended and robust behavior.
      # enable_git_follow is off for the same reason: following renames re-reads
      # history per page and reintroduces the same empty-result fallback.
      enable_creation_date: false
      enable_git_follow: false
      type: date
      exclude:
        - api-reference/generated/**
  - mermaid2
  - redirects
  - minify:
      minify_html: true
{%- endmacro %}
{%- macro not_in_nav_block() -%}
not_in_nav: |
  api-reference/generated/**
{%- endmacro %}
{%- macro markdown_extensions_block() -%}
markdown_extensions:
  - attr_list
  - md_in_html
  - tables
  - toc:
      permalink: true
  - pymdownx.highlight
  - pymdownx.inlinehilite
  - pymdownx.superfences
  - pymdownx.tasklist:
      custom_checkbox: true
{%- endmacro %}
{%- macro validation_block() -%}
validation:
  omitted_files: warn
  absolute_links: warn
  unrecognized_links: warn
{%- endmacro %}
