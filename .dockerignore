!*.mk
!pyproject.toml
!README.md
!uv.lock
!.mise.toml
!mise.lock
!mise.version
!.mise/
!.mise/locks/
!.mise/locks/**
.mise/locks/*.local/
!bin/
!bin/mise
!bin/mise.cmd
!.python-version
!.default-python-packages
!config/
!config/**
!scripts/dispatch.py
!src/
!src/**
!tests/
!tests/**
!tests/fixtures/ci/docker/
